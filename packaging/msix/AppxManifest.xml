<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package for the Microsoft Store. build.ps1 fills in the @…@
  values: the identity comes from Partner Center (Product identity), the
  version from Cargo.toml.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>nubmiddle</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 11 (what it is made and tested for). -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The languages of the app (and of its Store listings). -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ja-jp" />
  </Resources>

  <Applications>
    <Application Id="nubmiddle" Executable="nubmiddle.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="nubmiddle"
        Description="Middle click and scrolling with the middle button of a TrackPoint-style pointing stick"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows" (package::startup_task): off until turned on from the tray menu. -->
        <uap5:Extension Category="windows.startupTask" Executable="nubmiddle.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="nubmiddle" Enabled="false" DisplayName="nubmiddle" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop (Win32) app: the low-level mouse hook, SendInput, the system cursors, raw input, the tray icon. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
